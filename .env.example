# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Paper trading only. These are Alpaca *paper* credentials — generated from the
# paper dashboard, valid only against the paper endpoint, and unable to move
# real money even if they leak. Do not put live keys in this file or any other
# file in this repository.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
