.venv/
__pycache__/
*.pyc
.pytest_cache/

# Cached market data — reproducible from source, not worth versioning
data_store/
*.parquet

# Generated report: a data snapshot, regenerate with scripts/dashboard.py
dashboard.html
update.log

# Same, for the briefing — regenerate with scripts/brief.py.
# research_store/notes.json is deliberately NOT ignored: the notes are authored
# content, not a derived artifact. Rerunning would produce different prose, so
# losing them loses work rather than costing a rebuild.
research.html

# Live-loop state: local to a run, and the kill switch is an operator action
journal.jsonl
HALT

# Secrets. This repo is public: nothing below ever gets committed.
.env
.env.*
!.env.example
secrets.*
credentials.*
*.key
*.pem
